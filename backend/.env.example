# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# OpenAI-compatible endpoint (specs/02-agent-runtime.md MG-1).
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# Default model for chat turns and eval trials. Kept cheap since this runs
# at volume (N trials per case per eval run).
MODEL_NAME=gpt-4o-mini

# Optional overrides. Unset falls back to MODEL_NAME.
# JUDGE_MODEL_NAME: used for llm_judge eval checks (specs/04).
JUDGE_MODEL_NAME=

# IMPROVER_MODEL_NAME: used for the improver's diagnose+propose call
# (specs/05). This is a single reasoning-heavy call per proposal (not
# per-trial), so a stronger model is affordable here even when MODEL_NAME is
# kept cheap for volume. Verified during Phase 5 (see DECISIONS.md): with
# gpt-4o-mini for everything, scripts/e2e_improve.py's real-model fix rate
# was unreliable (~2/6 across two independent 3-run sets); setting this to
# gpt-4o raised it to 3/3 across two more runs. Recommended: gpt-4o.
IMPROVER_MODEL_NAME=gpt-4o

# Optional: override the SQLite DB path/URL (default: backend/data/app.db).
DATABASE_URL=
